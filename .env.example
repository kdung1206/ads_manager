# ---------------------------------------------------------------------------
# Security keys — bắt buộc, server crash ngay khi khởi động nếu thiếu (không
# có giá trị mặc định hardcode, vì bất kỳ giá trị commit trong repo cũng công
# khai). Tạo mỗi giá trị bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Supabase (Postgres) — project RIÊNG cho ads_manager, không dùng chung với
# marketing_report_v2. Lấy tại Supabase Dashboard > Project Settings > API.
# Đây là biến phía SERVER (không có tiền tố VITE_) — không bao giờ commit giá
# trị thật. Không đặt 2 biến này trong .env.local khi chạy dev cục bộ nếu
# muốn tự cách ly khỏi dữ liệu thật (dữ liệu sẽ lưu vào src/db_store.json).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Facebook Marketing API — cần Access Token có quyền ads_management (không
# phải chỉ ads_read, vì app này TẠO/SỬA/XÓA campaign thật, không chỉ đọc báo
# cáo) để nút "Đẩy lên nền tảng" hoạt động thật. Token được nhập trực tiếp
# trong UI (Kết nối nền tảng → Facebook), mã hóa trước khi lưu — không cần
# khai báo ở đây.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google Ads API — cần Developer Token (Google Ads API Center) + OAuth Client
# ID/Secret + refresh token của một tài khoản có quyền trên MCC. CHƯA cấu
# hình ở phase này — route /api/campaigns/:id/push trả lỗi rõ ràng cho tới
# khi các giá trị dưới đây được điền và code nối API thật được bổ sung.
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# TikTok Business API (Ads Management) — KHÁC với app TikTok Login Kit đã
# dùng cho Social Report (organic) trong marketing_report_v2; ads management
# cần một app TikTok for Business riêng, scope khác. CHƯA cấu hình ở phase
# này.
# ---------------------------------------------------------------------------
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
